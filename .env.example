# Copy this file to .env and edit. Never commit .env.

# --- Vault -----------------------------------------------------------------
# Leave blank to use the bundled ./vault folder, or point at an Obsidian vault:
# VAULT_PATH=C:/Users/rishi/Documents/MyVault
VAULT_PATH=

# --- AI provider -----------------------------------------------------------
# ollama = local, free, private (default) | groq = free tier | gemini = free tier
LLM_PROVIDER=ollama

# Ollama (no key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Groq - free key from https://console.groq.com/keys
# Model availability varies by key: GET /openai/v1/models to list yours.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini - free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Tuning ----------------------------------------------------------------
TOP_K=5
MAX_NOTE_CHARS=4000
HOST=127.0.0.1
PORT=8000
